# Reference for the variables Portainer's stack needs — add these under the
# stack's "Environment variables" UI, not as an actual .env file: Portainer's
# git-stack deploys substitute ${VARS} into the compose file at render time,
# there's no real .env file on disk for docker-compose's env_file: to load
# (docker-compose.prod.yml deliberately doesn't use env_file: for this
# reason). Not the same values as the local-dev .env.example.
#
# DATABASE_URL is deliberately not listed here; docker-compose.prod.yml
# builds it from POSTGRES_PASSWORD and the internal bankroll-db hostname
# directly.

CONTAINER_NAME=bankroll
# IMAGE_NAME defaults to ghcr.io/comprofix/bankroll if left unset. Only
# needed if you're running your own fork's image (e.g.
# ghcr.io/yourname/bankroll) or a locally-built one (see README).
# IMAGE_NAME=ghcr.io/comprofix/bankroll
IMAGE_TAG=latest
HOSTNAME=bankroll.example.com

POSTGRES_PASSWORD=change-me

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used by the container's entrypoint to create your one user account on
# first start (safe to leave set — it no-ops on every start after that).
SEED_EMAIL=you@example.com
SEED_PASSWORD=change-me

# Leave unset in Portainer — this is real HTTPS behind Traefik, so the
# cookie should stay Secure. Only ever set this to "false" for local
# non-HTTPS testing (e.g. the Android emulator).
# COOKIE_SECURE=false

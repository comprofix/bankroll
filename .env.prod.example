# For the Portainer stack's .env — NOT the same values as local .env.example.
# DATABASE_URL is deliberately not set here; docker-compose.prod.yml builds
# it from POSTGRES_PASSWORD and the internal bankroll-db hostname directly.

CONTAINER_NAME=bankroll
IMAGE_TAG=latest
HOSTNAME=bankroll.example.com

POSTGRES_PASSWORD=change-me

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used once by `db:migrate`/`db:seed` (see below) to create your one user account.
SEED_EMAIL=you@example.com
SEED_PASSWORD=change-me

# Leave unset here — this is real HTTPS behind Traefik, so the cookie should
# stay Secure. Only ever set this to "false" for local non-HTTPS testing
# (e.g. the Android emulator), never in this file.
# COOKIE_SECURE=false

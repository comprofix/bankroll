DATABASE_URL=postgres://bankroll:bankroll@localhost:5432/bankroll

# Random 32+ byte secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used once by `npm run db:seed` to create your single user account.
SEED_EMAIL=you@example.com
SEED_PASSWORD=change-me

# Leave unset (defaults to secure) for any real deployment served over HTTPS.
# Only set to "false" for local testing over plain HTTP where the browser
# won't treat the host as secure — e.g. the Android emulator's 10.0.2.2,
# which (unlike "localhost") gets no secure-cookie exception in Chromium.
# COOKIE_SECURE=false
